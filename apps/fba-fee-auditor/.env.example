# ── Seller-Central API (your SP-API gateway) ────────────────────────────────
# The fee report (Amazon's measured dims + charged fee) is pulled through here.
SELLER_CENTRAL_API_URL=http://localhost:8000
SELLER_CENTRAL_API_KEY=change_this_to_match_seller_central_api

# ── Product Library = supply-chain-app's Supabase project ───────────────────
# Read-only, server-side only. The packaging_specs/products tables are RLS-gated
# to authenticated roles, so use the project's SERVICE_ROLE key here (it bypasses
# RLS). This key is never exposed to the browser — it's only read in API routes.
PRODUCT_LIBRARY_SUPABASE_URL=https://utioginmnrlzxlncajug.supabase.co
PRODUCT_LIBRARY_SUPABASE_KEY=your-service-role-key

# Which packaging_specs.spec_type is the customer-facing unit (vs master_carton).
PRODUCT_LIBRARY_UNIT_SPEC_TYPE=unit
# Prefer an approved spec over draft/in_review when both exist ("false" to ignore).
PRODUCT_LIBRARY_PREFER_APPROVED=true
# Base URL of the supply-chain-app UI, for "Add dimensions" deep links.
# Dev default is the Vite port; set to your deployed URL in production.
PRODUCT_LIBRARY_APP_URL=http://localhost:8080
